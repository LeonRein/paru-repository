# Maintainer: Leon Rein <leon@lr-net.com>

pkgname=auto-loudness
pkgver=0.4.0
pkgrel=1
pkgdesc="ISO 226 loudness compensation that follows the Focusrite Scarlett volume knob"
arch=('any')
url="https://github.com/LeonRein/auto-loudness"
license=('MIT')
depends=('python' 'pipewire' 'alsa-utils')
optdepends=('python-gobject: filter curve window'
            'gtk4: filter curve window'
            'libadwaita: filter curve window'
            'libpulse: panel icon')
# Pure Python, nothing to build: the tag archive is installed as-is.
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('a6507dfbee65d8e160ac9333ff8ddc5cb7727cebafe5fba1489b530cfe0c367a')

package() {
	cd "$pkgname-$pkgver"
	# the gui module is imported from the script's own (symlink-resolved) directory
	install -Dm755 auto_loudness.py "$pkgdir/usr/lib/$pkgname/auto_loudness.py"
	install -Dm644 auto_loudness_gui.py "$pkgdir/usr/lib/$pkgname/auto_loudness_gui.py"
	install -Dm644 auto_loudness_tray.py "$pkgdir/usr/lib/$pkgname/auto_loudness_tray.py"
	install -dm755 "$pkgdir/usr/bin"
	ln -s "/usr/lib/$pkgname/auto_loudness.py" "$pkgdir/usr/bin/auto-loudness"
	install -Dm644 io.github.leonrein.AutoLoudness.desktop "$pkgdir/usr/share/applications/io.github.leonrein.AutoLoudness.desktop"
	install -Dm644 io.github.leonrein.AutoLoudness.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.leonrein.AutoLoudness.svg"
	install -Dm644 auto-loudness.service "$pkgdir/usr/lib/systemd/user/auto-loudness.service"
	# enabled for every user, starting with PipeWire (opt out: systemctl --user mask auto-loudness)
	install -dm755 "$pkgdir/usr/lib/systemd/user/pipewire.service.wants"
	ln -s ../auto-loudness.service "$pkgdir/usr/lib/systemd/user/pipewire.service.wants/auto-loudness.service"
	install -Dm644 auto-loudness-tray.desktop "$pkgdir/etc/xdg/autostart/auto-loudness-tray.desktop"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
	install -Dm644 config.example.toml "$pkgdir/usr/share/doc/$pkgname/config.example.toml"
}
