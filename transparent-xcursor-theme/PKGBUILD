# Maintainer: Leon Rein <leon@lr-net.com>

pkgname=transparent-xcursor-theme
pkgver=1.1.0
pkgrel=1
pkgdesc="Fully transparent Xcursor theme, for hiding the pointer in cage/kiosk sessions"
arch=('any')
url="https://github.com/LeonRein/transparent-xcursor-theme"
license=('MIT')

# Upstream CI builds the theme with xcursorgen and publishes the finished
# cursors as a release asset, so there is nothing to compile here: no build()
# function and no makedepends. Release assets are stable once uploaded, which is
# why this can carry a real checksum rather than SKIP.
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('4271f933c95353fe734a3d230ec79234d73978a859fd9b41b07865ec92041086')

package() {
	cd "$pkgname-$pkgver"

	# -a preserves the ~168 relative symlinks; copying them as regular files
	# would turn a 150 KB theme into roughly 20 MB.
	install -d "$pkgdir/usr/share/icons"
	cp -a transparent "$pkgdir/usr/share/icons/transparent"

	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
